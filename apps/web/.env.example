# OpenRouteService API key (server-side only)
# Never use NEXT_PUBLIC_ prefix; keep this server-only.
OPENROUTE_API_KEY=

# ============================================================================
# Safe Maps Data Source Configuration
# ============================================================================

# Data source selector: local | supabase
# Default: local (when not set or any other value)
# Set to 'supabase' only in verified server environments.
SAFE_MAPS_DATA_SOURCE=local

# ============================================================================
# Supabase Connection (Optional)
# ============================================================================
# These variables are only required when SAFE_MAPS_DATA_SOURCE=supabase.
# They intentionally avoid NEXT_PUBLIC_SUPABASE_* to prevent collisions with
# other Supabase projects in shared environments.

# Supabase project URL
SAFE_MAPS_SUPABASE_URL=

# Publishable key (anon/public role)
# Used for RLS-protected SELECT queries. Safe to share in public contexts.
# Required when SAFE_MAPS_DATA_SOURCE=supabase.
SAFE_MAPS_SUPABASE_PUBLISHABLE_KEY=

# Secret key (service_role)
# Bypasses RLS entirely. Server-side only; never expose to browser.
# Optional if publishable key is configured; use for admin operations only.
SAFE_MAPS_SUPABASE_SECRET_KEY=

# Do not use NEXT_PUBLIC_SUPABASE_* for Safe Maps while another project may
# define those variables in the same environment.
