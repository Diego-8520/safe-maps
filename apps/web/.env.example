# OpenRouteService — server-side only, never use NEXT_PUBLIC_ for this key
OPENROUTE_API_KEY=

# Safe Maps data source. Default in code is local when this is absent.
# Allowed values: local | supabase
SAFE_MAPS_DATA_SOURCE=local

# Safe Maps Supabase project variables.
# These intentionally avoid NEXT_PUBLIC_SUPABASE_* to prevent collisions with
# other Supabase projects in shared local or Vercel environments.
SAFE_MAPS_SUPABASE_URL=
SAFE_MAPS_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Bypasses RLS, so never expose it to the browser.
SAFE_MAPS_SUPABASE_SECRET_KEY=

# Do not use NEXT_PUBLIC_SUPABASE_* for Safe Maps while another project may
# define those variables in the same environment.
