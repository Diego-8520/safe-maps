# OpenRouteService — server-side only, never use NEXT_PUBLIC_ for this key
OPENROUTE_API_KEY=

# Supabase — URL is safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=

# Supabase — publishable (anon) key, safe for browser clients
# Scoped by Row Level Security (RLS); not a secret
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — secret (service role) key, server-side only
# Bypasses RLS — never expose to the browser, never use NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
